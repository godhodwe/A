end

-- ★ 초반 강제 루트 pick
function pickPriorityRoot(letter)
    if type(letter) \~= "string" or #letter < 3 then return nil end
    local list = PRIORITY_BY_START[letter]
    if not list then return nil end
    for _, w in ipairs(list) do
        if isAllowed(w) and not (RACE and (RACE.used[w] or RACE.dead[w])) then
            return w, "root-priority"
        end
    end
    return nil
end

