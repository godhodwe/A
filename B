    ["훠"] = {"훠청"},
}
RESCUE_ENABLE = true

function communityRescue(letter)
    if not (RESCUE_ENABLE and RACE) then return nil end
    local ws = COMMUNITY_RESCUE[letter]
    if not ws then return nil end
    for _, rw in ipairs(ws) do
        if isAllowed(rw) and not (RACE.used[rw] or RACE.dead[rw]) then
            RACE.dead[rw] = true
            return rw
        end
    end
    return nil
end

-- ★ 최종 racePick (초반 루트 강제 + 로컬 필터)
function racePick(letter)
    if not RACE then return nil, "no-data" end

    -- 초반 강제
    if state.movesThisRound == 0 then
        local w, note = pickPriorityRoot(letter)
        if w then
            return w, note
        end
        return nil, "no-root-opener"
    end

    -- 중후반: 엔진 + 로컬 필터
    local w, why = RACE:pickFor(letter)
    if w and isAllowed(w) then
        return w, why
    end

    if RACE.queue then
        while true do
            local nextW = RACE:_next()
            if not nextW then break end
            if isAllowed(nextW) then
                return nextW, RACE.note or why
            end
        end
    end

    local rw = communityRescue(letter)
    if rw and isAllowed(rw) then
        return rw, "community-rescue"
    end

    maybeLearnMidKill(letter)
    return nil, "no-allowed-word"
end

