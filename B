            if type(w) == "string" and #w >= 3 then
                ALLOWED_WORDS[w] = true
            end
        end
        print("[local] full words loaded: " .. tostring(#full))
    else
        print("[local] WARNING: full word list missing")
    end

    local function ingestRoots(data)
        if type(data) \~= "table" then return end
        for _, item in ipairs(data) do
            for _, w in ipairs(item.words or {}) do
                if type(w) == "string" and #w >= 3 and ALLOWED_WORDS[w] then
                    local start = string.sub(w, 1, 3)
                    PRIORITY_BY_START[start] = PRIORITY_BY_START[start] or {}
                    table.insert(PRIORITY_BY_START[start], w)
                end
            end
        end
    end

    local rare = loadJson(LOCAL_RARE_ROOTS_FILE)
    local main = loadJson(LOCAL_MAIN_ROOTS_FILE)
    ingestRoots(rare)
    ingestRoots(main)

    local prioCount = 0
    for _, list in pairs(PRIORITY_BY_START) do prioCount = prioCount + #list end
    print("[local] priority root words ready: " .. prioCount)
end

